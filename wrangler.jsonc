{
  // Worker 名 = workers.dev 网址前缀；Dashboard 连接 GitHub 时用户已命名为 travel-handbook
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travel-handbook",
  "compatibility_date": "2026-09-15",
  "assets": {
    // 静态资产模式：把行程目录整个当站点根伺服，italy-iceland/index.html 自动成为首页
    "directory": "./italy-iceland",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
